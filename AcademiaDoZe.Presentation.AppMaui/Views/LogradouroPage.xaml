<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="CEP" FontAttributes="Bold" />
            <Entry Text="{Binding Cep}" Placeholder="00000-000" Keyboard="Numeric" />

            <Label Text="Logradouro / Rua" FontAttributes="Bold" />
            <Entry Text="{Binding LogradouroNome}" Placeholder="Nome da rua" />

            <Label Text="Bairro" FontAttributes="Bold" />
            <Entry Text="{Binding Bairro}" Placeholder="Nome do bairro" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Cidade" FontAttributes="Bold" />
                    <Entry Text="{Binding Cidade}" Placeholder="Cidade" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="UF" FontAttributes="Bold" />
                    <Entry Text="{Binding Uf}" Placeholder="UF" MaxLength="2" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Cancelar" Style="{StaticResource ButtonSecondary}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Salvar" Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>