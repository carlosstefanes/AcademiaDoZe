<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AcessoPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             x:DataType="vm:AcessoViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Card 1: Seleção de Modo (Aluno / Colaborador) -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Controle de Acesso / Catraca" Style="{StaticResource Headline}" HorizontalTextAlignment="Center" FontSize="20"/>
                    <Label Text="Selecione se o acesso é de um Aluno ou Colaborador:" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" HorizontalTextAlignment="Center"/>

                    <!-- Botões de Alternância Aluno / Colaborador -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,5">
                        <Button Grid.Column="0" Text="&#xe80c;  Aluno" FontFamily="MaterialIcons" FontSize="14" HeightRequest="45"
                                Command="{Binding SelecionarModoAlunoCommand}"
                                BackgroundColor="{Binding AlunoButtonColor}"
                                TextColor="{Binding AlunoButtonTextColor}"/>

                        <Button Grid.Column="1" Text="&#xea67;  Colaborador" FontFamily="MaterialIcons" FontSize="14" HeightRequest="45"
                                Command="{Binding SelecionarModoColaboradorCommand}"
                                BackgroundColor="{Binding ColaboradorButtonColor}"
                                TextColor="{Binding ColaboradorButtonTextColor}"/>
                    </Grid>

                    <Label Text="{Binding ModoAtualTexto}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#818CF8}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Card 2: Localizar Pessoa -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Localizar Pessoa" Style="{StaticResource SubHeadline}" FontSize="16"/>

                    <!-- Caixa de Busca -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding SearchText}" Placeholder="Buscar por nome ou CPF..." HeightRequest="42" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding BuscarPessoaCommand}"/>
                        <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" HeightRequest="42" WidthRequest="48" Padding="0" Command="{Binding BuscarPessoaCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <!-- Seletor de Pessoa -->
                    <Label Text="{Binding PessoasLabel}" FontSize="13" FontAttributes="Bold"/>
                    <Picker Title="{Binding PickerPlaceholder}"
                            ItemsSource="{Binding PessoasDisponiveis}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding SelectedPessoa}"
                            HeightRequest="42"/>
                </VerticalStackLayout>
            </Border>

            <!-- Card 3: Identificação e Liberação -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Identificação e Liberação" Style="{StaticResource SubHeadline}" FontSize="16"/>

                    <Border Padding="12" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                            <!-- Foto circular -->
                            <Border Grid.Column="0" HeightRequest="72" WidthRequest="72" StrokeShape="RoundRectangle 36" Stroke="{StaticResource Primary}" StrokeThickness="2" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">
                                <Image Source="{Binding SelectedPessoa.Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill" HeightRequest="72" WidthRequest="72"/>
                            </Border>

                            <!-- Informações da Pessoa -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding SelectedPessoa.Nome, TargetNullValue='Nenhuma pessoa selecionada'}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding SelectedPessoa.Cpf, StringFormat='CPF: {0}', TargetNullValue='CPF: -'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>

                                <!-- Badge de Status Dentro / Fora -->
                                <Border Margin="0,4,0,0" Padding="8,3" HorizontalOptions="Start" StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{Binding BadgeBackgroundColor}">
                                    <Label Text="{Binding StatusTexto}" FontSize="11" FontAttributes="Bold" TextColor="{Binding BadgeTextColor}"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Botão de Ação: Registrar Entrada / Saída -->
                    <Button Text="{Binding BotaoAcaoTexto}"
                            Style="{StaticResource ButtonPrimary}"
                            HeightRequest="48"
                            FontSize="15"
                            FontAttributes="Bold"
                            Command="{Binding RegistrarAcessoCommand}"
                            IsEnabled="{Binding TemPessoaSelecionada}"/>

                    <!-- Banner de Feedback (Sucesso / Negado) -->
                    <Border IsVisible="{Binding FeedbackVisivel}"
                            Padding="12" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{Binding FeedbackBackgroundColor}"
                            Stroke="{Binding FeedbackBorderColor}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding FeedbackIcon}" FontFamily="MaterialIcons" FontSize="26" VerticalOptions="Center" TextColor="White"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FeedbackTitulo}" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                                <Label Text="{Binding FeedbackMensagem}" FontSize="12" TextColor="#F1F5F9" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Card 4: Acessos Registrados Hoje -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Acessos Registrados Hoje" Style="{StaticResource SubHeadline}" FontSize="16" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="Atualizar" Style="{StaticResource ButtonSmall}" Command="{Binding AtualizarHistoricoCommand}" HeightRequest="36" Padding="12,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <!-- Lista de Acessos com BindableLayout -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AcessosHoje}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:AcessoHistoricoItemDto">
                                <Border Margin="0,2" Padding="10" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding NomePessoa}" FontAttributes="Bold" FontSize="13"/>
                                            <Label Text="{Binding Descricao}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding HoraFormatada}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#A5B4FC}" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Mensagem quando não há acessos hoje -->
                    <VerticalStackLayout IsVisible="{Binding NaoTemAcessosHoje}" Padding="20" Spacing="8" HorizontalOptions="Center">
                        <Label Text="&#xe88e;" FontFamily="MaterialIcons" FontSize="36" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"/>
                        <Label Text="Nenhum acesso registrado hoje." FontSize="13" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
